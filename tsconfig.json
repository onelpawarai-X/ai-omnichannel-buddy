{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@openreel/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@openreel/agent/*": [
        "./packages/agent/src/*"
      ],
      "@openreel/agent-runner": [
        "./packages/agent-runner/src/index.ts"
      ],
      "@openreel/agent-runner/*": [
        "./packages/agent-runner/src/*"
      ],
      "@openreel/core": [
        "./packages/core/src/index.ts"
      ],
      "@openreel/core/*": [
        "./packages/core/src/*"
      ],
      "@openreel/creation-agent": [
        "./packages/creation-agent/src/index.ts"
      ],
      "@openreel/creation-agent/*": [
        "./packages/creation-agent/src/*"
      ],
      "@openreel/creation-bindings": [
        "./packages/creation-bindings/src/index.ts"
      ],
      "@openreel/creation-bindings/*": [
        "./packages/creation-bindings/src/*"
      ],
      "@openreel/creation-core": [
        "./packages/creation-core/src/index.ts"
      ],
      "@openreel/creation-core/*": [
        "./packages/creation-core/src/*"
      ],
      "@openreel/creation-schema": [
        "./packages/creation-schema/src/index.ts"
      ],
      "@openreel/creation-schema/*": [
        "./packages/creation-schema/src/*"
      ],
      "@openreel/fxpkg": [
        "./packages/fxpkg/src/index.ts"
      ],
      "@openreel/fxpkg/*": [
        "./packages/fxpkg/src/*"
      ],
      "@openreel/image-core": [
        "./packages/image-core/src/index.ts"
      ],
      "@openreel/image-core/*": [
        "./packages/image-core/src/*"
      ],
      "@openreel/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@openreel/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}